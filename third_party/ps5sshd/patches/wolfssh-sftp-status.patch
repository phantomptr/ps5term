 /* for WLOCALTIME if defined */
 #include <wolfssl/wolfcrypt/wc_port.h>
 
+#ifndef USE_WINDOWS_API
+#include <errno.h>
+
+/* Map the errno of a failed filesystem call to an SFTP status, so a missing
+ * path is reported as NO_SUCH_FILE and a denied one as PERMISSION_DENIED
+ * instead of a generic FAILURE. Clients such as libssh2 treat FAILURE as a
+ * hard error when probing for files that do not exist. */
+static byte SFTP_ErrnoToStatus(int err)
+{
+    if (err == ENOENT || err == ENOTDIR)
+        return WOLFSSH_FTP_NOFILE;
+    if (err == EACCES || err == EPERM)
+        return WOLFSSH_FTP_PERMISSION;
+    return WOLFSSH_FTP_FAILURE;
+}
+#else
+    #define SFTP_ErrnoToStatus(e) ((void)(e), WOLFSSH_FTP_FAILURE)
+#endif
+
 
