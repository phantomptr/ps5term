CONFIG_64BIT=y
CONFIG_RISCV=y
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_SOC_VIRT=y
CONFIG_NONPORTABLE=y
CONFIG_RISCV_SBI_V01=y
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
# CONFIG_SMP is not set
# CONFIG_RISCV_ISA_V is not set
# SOC_VIRT selects RISCV_ALTERNATIVE; unsupported ISA extensions stay disabled.
# CONFIG_COMPAT is not set
CONFIG_LOCALVERSION="-ps5term"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="ps5term-linux"
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_BASE_SMALL=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLOCK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_CMDLINE="earlycon=sbi"
CONFIG_CMDLINE_EXTEND=y
CONFIG_HVC_DRIVER=y
# CONFIG_HVC_RISCV_SBI is not set
CONFIG_RISCV_TIMER=y
CONFIG_RISCV_INTC=y
CONFIG_SIFIVE_PLIC=y
CONFIG_EXT2_FS=y
CONFIG_EXT2_FS_XATTR=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_BUGVERBOSE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_MODULES is not set

# Bounded app-private virtio shared folder; no TCP 9p server.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
# CONFIG_9P_FS_POSIX_ACL is not set
# CONFIG_9P_FS_SECURITY is not set

# Optional in-app userspace NAT (virtio-net). No guest listener is reachable from outside.
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
