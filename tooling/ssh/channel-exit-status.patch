+int wolfSSH_ChannelSendExitStatus(WOLFSSH_CHANNEL* channel, word32 status)
+{
+    if (channel == NULL || channel->ssh == NULL)
+        return WS_BAD_ARGUMENT;
+    if (SendAfterDisconnect(channel->ssh))
+        return WS_FATAL_ERROR;
+    if (!channel->openConfirmed)
+        return WS_CHANNEL_NOT_CONF;
+    if (channel->ssh->isKeying)
+        return WS_REKEYING;
+    return SendChannelExit(channel->ssh, channel->peerChannel, (int)status);
+}
